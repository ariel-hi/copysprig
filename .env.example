# No secret is required for the site. Public settings live in config.json.
# Use normal Firebase CLI authentication: firebase login
# Never place credentials in config.json, HTML, source, or repository.
# Raw user-entered text must never be added to analytics event payloads.
# Optional health origin; generated canonicals still use config.json.siteUrl.
# SITE_URL=https://copysprig.web.app
# Optional nonstandard installed Firebase CLI module path for CI provisioning.
# COPYSPRIG_FIREBASE_TOOLS_PATH=C:\path\to\node_modules\firebase-tools
